# Hotspot ayarları
HOTSPOT_INTERFACE=wlan0
WG_INTERFACE=wg0
HOTSPOT_SSID=WireGuardHotspot
HOTSPOT_PASSWORD=12345678

# WireGuard ayarları
WG_PRIVATE_KEY=PRIVATE_KEY_BURAYA
WG_ADDRESS=10.0.0.2/24
WG_DNS=1.1.1.1
WG_PEER_PUBLIC_KEY=SERVER_PUBLIC_KEY_BURAYA
WG_ENDPOINT=your.server.com:51820
WG_ALLOWED_IPS=0.0.0.0/0
WG_KEEPALIVE=25
